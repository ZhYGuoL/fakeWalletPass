# Use the project’s production hostname in QR/pass links (e.g. https://pkpassdownload.vercel.app).
# Team-style URLs like *-zhyguols-projects.vercel.app may require Vercel login if Deployment Protection is on.
#
# Apple Wallet signing (local pkpass tooling). Paths are relative to wallet-web/.
PASS_BUILD_OUTPUT_DIR=../build
WWDR_PEM_PATH=../certs/wwdr.pem
SIGNER_CERT_PATH=../certs/signer.pem
SIGNER_KEY_PATH=../certs/signer.key
DUMMY_QR_BASE_URL=https://example.invalid/test-pass
#
# Optional: POST each engagement event as JSON (Slack incoming webhook, Zapier catch hook, etc.)
ENGAGEMENT_WEBHOOK_URL=

# Optional: redirect path after /api/get-pass (default /event-ticket.pkpass)
# PASS_FILE_PATH=
