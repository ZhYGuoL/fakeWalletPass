{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "devCommand": "node dev-server.mjs",
  "buildCommand": "exit 0",
  "installCommand": "exit 0",
  "rewrites": [
    {
      "source": "/public/event-ticket.pkpass",
      "destination": "/event-ticket.pkpass"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.pkpass",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.apple.pkpass"
        }
      ]
    }
  ]
}
