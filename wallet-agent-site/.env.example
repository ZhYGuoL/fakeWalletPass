# Photon Spectrum Cloud — https://app.photon.codes/ → Project Settings
# Use the Business project for new sign-ups (Pro project stays on the legacy Railway worker).
PROJECT_ID=
PROJECT_SECRET=

# Business dedicated iMessage line (E.164). When set, landing-page sign-ups register as
# type "dedicated" on this line instead of the shared pool.
AGENT_LINE_PHONE=+16282649132

# Waitlist storage on Vercel (Storage → Blob → connect to this project; sets BLOB_STORE_ID)
# BLOB_READ_WRITE_TOKEN=

# Public site URL encoded in the hero QR code (optional override; prod defaults to keypass.zygl.dev)
VITE_SITE_URL=https://keypass.zygl.dev
